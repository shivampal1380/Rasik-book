# Backend configuration (copy to .env and adjust)

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:admin123@localhost:5433/rasid_book?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Set to 1 when serving over HTTPS in production
COOKIE_SECURE=0

# CORS: comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Seed (used by `npm run seed` / prisma db seed)
SEED_ADMIN_EMAIL=admin@nirankari.local
SEED_ADMIN_PASSWORD=admin12345
SEED_OPERATOR_EMAIL=operator@nirankari.local
SEED_OPERATOR_PASSWORD=operator123

# Temporary PDF output directory (used by PDF service)
PDF_OUTPUT_DIR=./tmp/pdf